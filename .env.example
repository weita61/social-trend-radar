# Local-only SQLite source of truth. Never commit the database file.
DATABASE_PATH=./data/social-trend-radar.sqlite
HOST=127.0.0.1
PORT=8787

# Phase 2+ connector secrets intentionally remain unset.
SUBMITTER_HASH_SECRET=
CAPTURE_API_URL=http://127.0.0.1:8787

# Phase 2 connectors. Keep real values in .env only.
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_LIMIT=8000

# Read-only Instagram / TikTok crawler. Keep disabled until the enabled
# platform's dedicated account has been logged in with `pnpm crawler:login`.
CRAWLER_ENABLED=false
CRAWLER_HEADLESS=false
CRAWLER_INTERVAL_MINUTES=30
CRAWLER_SCROLLS_PER_RUN=6
CRAWLER_WAIT_MS=4000
INSTAGRAM_CRAWL_URLS=https://www.instagram.com/reels/
TIKTOK_CRAWL_URLS=https://www.tiktok.com/foryou
# Set either platform URL list to an empty value to pause that platform.
# Optional overrides. Profiles default to ~/Library/Application Support/SocialTrendRadar/browser-profiles.
CRAWLER_PROFILE_ROOT=
CRAWLER_CHROME_EXECUTABLE=
CRAWLER_KILL_SWITCH_PATH=
